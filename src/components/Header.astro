---
interface NavLink {
  href: string;
  label: string;
  external?: boolean;
}

const navLinks: NavLink[] = [
  { href: '/', label: 'Home' },
  { href: '/toggle-timesheet-generator', label: '勤務表ジェネレーター' },
  { href: '/hiragana-gacha', label: 'ひらがなガチャ' },
  { href: '/hiragana-combo', label: '文字コンボ' },
  { href: '/SvgDrawer', label: 'SVGパス変換' },
  { href: '/bypass-puzzle', label: '回路パズル' },
  {
    href: 'https://parkour-all-realtime-location.web.app/',
    label: 'Parkour予定シェアマップ',
    external: true,
  },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  style="background: rgba(10,10,10,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid #2a2a2a;"
>
  <div class="container" style="max-width:1200px; margin:0 auto; padding:0 1.5rem;">
    <div style="display:flex; align-items:center; justify-content:space-between; height:64px;">
      <!-- Logo -->
      <a href="/" style="display:flex; align-items:center; gap:0.5rem; text-decoration:none;">
        <div
          style="background:#D2BEA4; color:#fff; font-weight:900; font-size:1rem; padding:0.25rem 0.6rem; border-radius:4px; letter-spacing:0.05em;"
        >
          NTR
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="desktop-nav">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="desktop-nav-link"
              style={`
                display:inline-flex;
                align-items:center;
                gap:0.25rem;
                font-size:0.875rem;
                font-weight:600;
                padding:0.25rem 0.5rem;
                border-radius:4px;
                transition:color 0.2s;
                color: ${currentPath === link.href ? '#D2BEA4' : '#d1d5db'};
                text-decoration:none;
              `}
            >
              <span>{link.label}</span>
              {link.external && (
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  style="opacity: 0.75;"
                  aria-hidden="true"
                >
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
              )}
            </a>
          ))
        }
      </nav>

      <!-- Hamburger Button (Mobile) -->
      <button
        id="menu-toggle-btn"
        class="mobile-menu-btn"
        type="button"
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger-bar top-bar"></span>
        <span class="hamburger-bar mid-bar"></span>
        <span class="hamburger-bar bot-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <nav class="mobile-nav-list">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class={`mobile-nav-item ${currentPath === link.href ? 'is-active' : ''}`}
          >
            <span>{link.label}</span>
            {link.external ? (
              <span class="mobile-external-badge">
                外部 ↗
              </span>
            ) : (
              currentPath === link.href && <span class="mobile-current-dot" aria-hidden="true">•</span>
            )}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<!-- Spacer for fixed header -->
<div style="height:64px;"></div>

<style>
  .desktop-nav {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }

  .desktop-nav-link:hover {
    color: #ffffff !important;
  }

  /* Hamburger Button */
  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    cursor: pointer;
    padding: 0;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .mobile-menu-btn:hover {
    border-color: #D2BEA4;
    background: rgba(255, 255, 255, 0.05);
  }

  .hamburger-bar {
    width: 20px;
    height: 2px;
    background-color: #e5e7eb;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center;
  }

  .mobile-menu-btn[aria-expanded="true"] .top-bar {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu-btn[aria-expanded="true"] .mid-bar {
    opacity: 0;
    transform: scaleX(0);
  }

  .mobile-menu-btn[aria-expanded="true"] .bot-bar {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Dropdown Menu */
  .mobile-menu {
    display: none;
    background: rgba(12, 12, 12, 0.98);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid #2a2a2a;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
  }

  .mobile-menu.is-open {
    display: block;
    animation: slide-down 0.2s ease-out;
  }

  @keyframes slide-down {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.5rem 1.25rem;
    gap: 0.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .mobile-nav-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    color: #d1d5db;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid #1f1f1f;
    transition: color 0.2s, background-color 0.2s, border-color 0.2s;
  }

  .mobile-nav-item:hover,
  .mobile-nav-item.is-active {
    color: #D2BEA4;
    background: rgba(210, 190, 164, 0.08);
    border-color: rgba(210, 190, 164, 0.3);
  }

  .mobile-external-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: rgba(210, 190, 164, 0.15);
    color: #D2BEA4;
    border: 1px solid rgba(210, 190, 164, 0.3);
  }

  .mobile-current-dot {
    color: #D2BEA4;
    font-size: 1.2rem;
    line-height: 1;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
    }
    .mobile-menu-btn {
      display: none;
    }
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('menu-toggle-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    if (btn.dataset.initialized === 'true') return;
    btn.dataset.initialized = 'true';

    const toggleMenu = (open?: boolean) => {
      const isCurrentlyOpen = btn.getAttribute('aria-expanded') === 'true';
      const willOpen = typeof open === 'boolean' ? open : !isCurrentlyOpen;

      btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      btn.setAttribute('aria-label', willOpen ? 'メニューを閉じる' : 'メニューを開く');
      menu.setAttribute('aria-hidden', willOpen ? 'false' : 'true');

      if (willOpen) {
        menu.classList.add('is-open');
      } else {
        menu.classList.remove('is-open');
      }
    };

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleMenu(false);
      });
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!btn.contains(target) && !menu.contains(target)) {
        toggleMenu(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleMenu(false);
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
