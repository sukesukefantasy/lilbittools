---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout
  title="回路バイパスパズル"
  description="パネルを回転させて回路を繋ぐパズルゲーム。左上のバッテリーから右下のエンジンまでエネルギーを届けよう。"
>
  <section class="puzzle-container">
    <div class="header-section">
      <p class="section-subtitle">CIRCUIT PUZZLE</p>
      <h1 class="section-title">回路のバイパスパズル</h1>
      <p class="puzzle-lead">
        パネルをタップして回転させ、左上の<span class="text-green">バッテリー</span>から右下の<span class="text-orange">エンジン</span>まで回路を繋いでください。
      </p>
    </div>

    <!-- コントロールバー -->
    <div class="control-bar">
      <div class="stats-group">
        <div class="stat-badge">
          <span class="stat-label">手数</span>
          <span id="move-count" class="stat-value">0</span>
        </div>
        <div id="status-badge" class="status-badge is-disconnected">
          <span class="status-dot"></span>
          <span id="status-text">回路遮断中</span>
        </div>
      </div>

      <div class="btn-group">
        <button id="sound-btn" type="button" class="btn-icon" aria-label="効果音切り替え" title="効果音 ON/OFF">
          <svg id="icon-sound-on" class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
          </svg>
          <svg id="icon-sound-off" class="icon is-hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </button>

        <button id="reset-btn" type="button" class="btn-action" title="初期配置に戻す">
          <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
          <span>やり直す</span>
        </button>

        <button id="new-game-btn" type="button" class="btn-action btn-primary-action" title="新しいパズルを生成">
          <svg class="icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
          </svg>
          <span>新しい問題</span>
        </button>
      </div>
    </div>

    <!-- パズル盤面ラッパー -->
    <div class="board-wrapper">
      <div id="puzzle-grid" class="puzzle-grid" role="grid" aria-label="回路パズル盤面">
        <!-- JavaScriptで動的生成 -->
      </div>

      <!-- クリア時オーバーレイ -->
      <div id="clear-overlay" class="clear-overlay is-hidden">
        <div class="clear-modal">
          <div class="clear-icon-wrap">
            <svg class="clear-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
            </svg>
          </div>
          <h2 class="clear-title">回路接続成功！</h2>
          <p class="clear-desc">エンジンへのエネルギーバイパスが開通しました！</p>
          <div class="clear-stats">
            <span>クリア手数: <strong id="modal-moves">0</strong>手</span>
          </div>
          <button id="modal-next-btn" type="button" class="btn-primary" style="margin-top: 1rem;">
            次の問題に挑戦
          </button>
        </div>
      </div>
    </div>

    <!-- ルール説明 -->
    <div class="instructions-card">
      <h2 class="instructions-title">あそびかた</h2>
      <ul class="instructions-list">
        <li><strong>タップで回転:</strong> パネルをタップ（またはクリック）すると、時計回りに90度回転します。</li>
        <li><strong>通電ルート:</strong> 左上のバッテリー（⚡）から右下のエンジン（⚙️）まで、途切れずにパイプを繋ぎます。</li>
        <li><strong>固定パネル:</strong> 鍵マーク（🔒）がついている始点と終点のパネルは回転できません。</li>
        <li><strong>光るパイプ:</strong> バッテリーから電力が届いているパイプはネオンイエローに光ります。</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .puzzle-container {
    max-width: 600px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
  }

  .header-section {
    text-align: center;
    margin-bottom: 2rem;
  }

  .puzzle-lead {
    color: #9ca3af;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-top: 0.5rem;
  }

  .text-green {
    color: #4ade80;
    font-weight: 700;
  }

  .text-orange {
    color: #fb923c;
    font-weight: 700;
  }

  /* コントロールバー */
  .control-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    background: #141414;
    border: 1px solid #262626;
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }

  .stats-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .stat-badge {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    background: #1f1f1f;
    padding: 0.35rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid #333;
  }

  .stat-label {
    font-size: 0.75rem;
    color: #9ca3af;
    font-weight: 700;
  }

  .stat-value {
    font-size: 1.15rem;
    font-weight: 900;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .status-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: 0.5rem;
    transition: all 0.25s ease;
  }

  .status-badge.is-disconnected {
    background: rgba(239, 68, 68, 0.12);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .status-badge.is-connected {
    background: rgba(234, 179, 8, 0.15);
    color: #facc15;
    border: 1px solid rgba(234, 179, 8, 0.5);
    box-shadow: 0 0 12px rgba(250, 204, 21, 0.2);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
  }

  .btn-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: #1f1f1f;
    border: 1px solid #333;
    color: #9ca3af;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-icon:hover {
    color: #fff;
    border-color: #555;
    background: #2a2a2a;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 0.5rem;
    background: #1f1f1f;
    border: 1px solid #333;
    color: #e5e7eb;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-action:hover {
    background: #2a2a2a;
    border-color: #555;
    color: #fff;
  }

  .btn-primary-action {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: #111;
  }

  .btn-primary-action:hover {
    background: #e2cca9;
    color: #000;
  }

  .icon {
    width: 1.15rem;
    height: 1.15rem;
  }

  .icon-sm {
    width: 0.95rem;
    height: 0.95rem;
  }

  .is-hidden {
    display: none !important;
  }

  /* 盤面 */
  .board-wrapper {
    position: relative;
    width: 100%;
    max-width: 480px;
    margin: 0 auto 2.5rem;
    aspect-ratio: 1 / 1;
    background: #0d0d0d;
    border: 2px solid #222;
    border-radius: 1rem;
    padding: 0.5rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
  }

  .puzzle-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 0.4rem;
    width: 100%;
    height: 100%;
    touch-action: manipulation;
  }

  :global(.puzzle-tile) {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.65rem;
    padding: 0;
    margin: 0;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
  }

  :global(.puzzle-tile:hover:not(.is-fixed)) {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.25);
  }

  :global(.puzzle-tile.is-fixed) {
    cursor: default;
    border-color: rgba(59, 130, 246, 0.5);
    background: rgba(59, 130, 246, 0.06);
  }

  :global(.puzzle-tile.is-powered) {
    background: rgba(250, 204, 21, 0.08);
    border-color: #facc15;
    border-width: 2px;
    box-shadow: inset 0 0 10px rgba(250, 204, 21, 0.15), 0 0 10px rgba(250, 204, 21, 0.2);
  }

  :global(.puzzle-tile.is-powered.is-fixed) {
    border-color: #facc15;
    background: rgba(250, 204, 21, 0.12);
  }

  :global(.tile-rotator) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :global(.tile-svg) {
    width: 80%;
    height: 80%;
    overflow: visible;
  }

  :global(.lock-badge) {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 14px;
    height: 14px;
    color: #60a5fa;
    pointer-events: none;
    opacity: 0.85;
  }

  :global(.puzzle-tile.is-powered .lock-badge) {
    color: #facc15;
  }

  /* パイプとアイコンのSVGスタイル */
  :global(.pipe-path) {
    stroke: #4b5563;
    fill: none;
    stroke-width: 14;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.2s ease, filter 0.2s ease;
  }

  :global(.is-powered .pipe-path) {
    stroke: #facc15;
    filter: drop-shadow(0 0 6px rgba(250, 204, 21, 0.8));
  }

  :global(.battery-icon) {
    fill: #22c55e;
    filter: drop-shadow(0 0 4px rgba(34, 197, 94, 0.4));
    transition: fill 0.2s ease, filter 0.2s ease;
  }

  :global(.is-powered .battery-icon) {
    fill: #facc15;
    filter: drop-shadow(0 0 8px rgba(250, 204, 21, 0.9));
  }

  :global(.engine-icon) {
    fill: #f97316;
    transform-origin: 50px 50px;
    transition: fill 0.2s ease, filter 0.2s ease;
  }

  :global(.is-powered .engine-icon) {
    fill: #facc15;
    filter: drop-shadow(0 0 8px rgba(250, 204, 21, 0.9));
    animation: engineSpin 3s linear infinite;
  }

  :global(.terminal-stub) {
    fill: #f97316;
    opacity: 0.6;
    transition: fill 0.2s, opacity 0.2s;
  }

  :global(.is-powered .terminal-stub) {
    fill: #facc15;
    opacity: 1;
    filter: drop-shadow(0 0 4px #facc15);
  }

  @keyframes engineSpin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* クリアオーバーレイ */
  .clear-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    z-index: 20;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .clear-modal {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .clear-icon-wrap {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(250, 204, 21, 0.15);
    border: 2px solid #facc15;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    box-shadow: 0 0 20px rgba(250, 204, 21, 0.4);
    animation: pulseGlow 1.5s ease-in-out infinite;
  }

  @keyframes pulseGlow {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 0 20px rgba(250, 204, 21, 0.4);
    }
    50% {
      transform: scale(1.08);
      box-shadow: 0 0 28px rgba(250, 204, 21, 0.7);
    }
  }

  .clear-icon {
    width: 32px;
    height: 32px;
    color: #facc15;
  }

  .clear-title {
    font-size: 1.5rem;
    font-weight: 900;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .clear-desc {
    color: #9ca3af;
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .clear-stats {
    font-size: 1rem;
    color: #e5e7eb;
    background: #1c1c1c;
    border: 1px solid #333;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
  }

  .clear-stats strong {
    color: #facc15;
  }

  /* ルール説明カード */
  .instructions-card {
    background: #111;
    border: 1px solid #222;
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .instructions-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 1rem;
  }

  .instructions-list {
    margin: 0;
    padding-left: 1.25rem;
    color: #9ca3af;
    font-size: 0.875rem;
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .instructions-list strong {
    color: #e5e7eb;
  }

  @media (max-width: 480px) {
    .puzzle-container {
      padding: 1.5rem 0.75rem 3rem;
    }

    .control-bar {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .stats-group {
      justify-content: space-between;
    }

    .btn-group {
      justify-content: flex-end;
    }

    .board-wrapper {
      padding: 0.35rem;
      border-radius: 0.75rem;
    }

    :global(.puzzle-tile) {
      border-radius: 0.5rem;
    }
  }
</style>

<script>
  import { BypassPuzzleLogic, type BypassPuzzleTile, type PipeType } from '../lib/bypass-puzzle';

  // 音響シンセサイザー (Web Audio API)
  class SoundManager {
    private ctx: AudioContext | null = null;
    private isMuted: boolean = false;

    constructor() {
      this.isMuted = localStorage.getItem('bypass_puzzle_muted') === 'true';
    }

    public get muted(): boolean {
      return this.isMuted;
    }

    public toggleMute(): boolean {
      this.isMuted = !this.isMuted;
      localStorage.setItem('bypass_puzzle_muted', this.isMuted ? 'true' : 'false');
      return this.isMuted;
    }

    private initCtx() {
      if (!this.ctx) {
        const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        this.ctx = new AudioCtx();
      }
      if (this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
    }

    public playClick() {
      if (this.isMuted) return;
      try {
        this.initCtx();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(360, now);
        osc.frequency.exponentialRampToValueAtTime(140, now + 0.06);

        gain.gain.setValueAtTime(0.12, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.start(now);
        osc.stop(now + 0.06);
      } catch {
        // Audio error fallback
      }
    }

    public playConnect() {
      if (this.isMuted) return;
      try {
        this.initCtx();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(520, now);
        osc.frequency.exponentialRampToValueAtTime(780, now + 0.1);

        gain.gain.setValueAtTime(0.1, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.start(now);
        osc.stop(now + 0.12);
      } catch {
        // Audio error fallback
      }
    }

    public playSuccess() {
      if (this.isMuted) return;
      try {
        this.initCtx();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        
        // Flutterのcharge.wavを意識した上昇チャージ＋和音アルペジオ
        const notes = [261.63, 329.63, 392.0, 523.25, 659.25]; // C, E, G, C, E
        notes.forEach((freq, i) => {
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          const startTime = now + i * 0.07;
          const duration = 0.35;

          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, startTime);

          gain.gain.setValueAtTime(0.15, startTime);
          gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration);

          osc.connect(gain);
          gain.connect(this.ctx.destination);

          osc.start(startTime);
          osc.stop(startTime + duration);
        });
      } catch {
        // Audio error fallback
      }
    }
  }

  // ゲームコントローラー
  class BypassPuzzleGameUI {
    private logic: BypassPuzzleLogic;
    private sound: SoundManager;
    private tileElements: Map<string, HTMLElement> = new Map();
    private tileTurns: Map<string, number> = new Map(); // スムーズな時計回り累積角度

    private gridContainer: HTMLElement;
    private moveCountEl: HTMLElement;
    private statusBadgeEl: HTMLElement;
    private statusTextEl: HTMLElement;
    private clearOverlayEl: HTMLElement;
    private modalMovesEl: HTMLElement;

    private soundBtn: HTMLButtonElement;
    private soundOnIcon: SVGElement;
    private soundOffIcon: SVGElement;
    private resetBtn: HTMLButtonElement;
    private newGameBtn: HTMLButtonElement;
    private modalNextBtn: HTMLButtonElement;

    constructor() {
      this.logic = new BypassPuzzleLogic(4, 4);
      this.sound = new SoundManager();

      this.gridContainer = document.getElementById('puzzle-grid') as HTMLElement;
      this.moveCountEl = document.getElementById('move-count') as HTMLElement;
      this.statusBadgeEl = document.getElementById('status-badge') as HTMLElement;
      this.statusTextEl = document.getElementById('status-text') as HTMLElement;
      this.clearOverlayEl = document.getElementById('clear-overlay') as HTMLElement;
      this.modalMovesEl = document.getElementById('modal-moves') as HTMLElement;

      this.soundBtn = document.getElementById('sound-btn') as HTMLButtonElement;
      this.soundOnIcon = document.getElementById('icon-sound-on') as unknown as SVGElement;
      this.soundOffIcon = document.getElementById('icon-sound-off') as unknown as SVGElement;
      this.resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
      this.newGameBtn = document.getElementById('new-game-btn') as HTMLButtonElement;
      this.modalNextBtn = document.getElementById('modal-next-btn') as HTMLButtonElement;

      this.initEvents();
      this.updateSoundIcons();
      this.renderFullGrid();
    }

    private initEvents() {
      this.soundBtn.addEventListener('click', () => {
        const isMuted = this.sound.toggleMute();
        this.updateSoundIcons();
      });

      this.resetBtn.addEventListener('click', () => {
        this.sound.playClick();
        this.logic.resetToInitial();
        // 累積ターン数を初期の回転に合わせる
        for (let r = 0; r < this.logic.rows; r++) {
          for (let c = 0; c < this.logic.cols; c++) {
            this.tileTurns.set(`${r},${c}`, this.logic.grid[r][c].rotation);
          }
        }
        this.clearOverlayEl.classList.add('is-hidden');
        this.updateAllTileVisuals();
        this.updateStatsUI();
      });

      this.newGameBtn.addEventListener('click', () => {
        this.sound.playClick();
        this.startNewGame();
      });

      this.modalNextBtn.addEventListener('click', () => {
        this.sound.playClick();
        this.startNewGame();
      });
    }

    private updateSoundIcons() {
      if (this.sound.muted) {
        this.soundOnIcon.classList.add('is-hidden');
        this.soundOffIcon.classList.remove('is-hidden');
      } else {
        this.soundOnIcon.classList.remove('is-hidden');
        this.soundOffIcon.classList.add('is-hidden');
      }
    }

    private startNewGame() {
      this.logic.initialize();
      this.clearOverlayEl.classList.add('is-hidden');
      this.renderFullGrid();
    }

    private renderFullGrid() {
      this.gridContainer.innerHTML = '';
      this.tileElements.clear();
      this.tileTurns.clear();

      for (let r = 0; r < this.logic.rows; r++) {
        for (let c = 0; c < this.logic.cols; c++) {
          const tile = this.logic.grid[r][c];
          const key = `${r},${c}`;
          this.tileTurns.set(key, tile.rotation);

          const tileBtn = document.createElement('button');
          tileBtn.type = 'button';
          tileBtn.className = `puzzle-tile${tile.isFixed ? ' is-fixed' : ''}`;
          tileBtn.dataset.r = String(r);
          tileBtn.dataset.c = String(c);
          tileBtn.setAttribute('aria-label', `タイル ${r + 1}行 ${c + 1}列 (${tile.type})`);
          if (tile.isFixed) {
            tileBtn.setAttribute('aria-disabled', 'true');
          }

          // 固定ロックアイコン
          if (tile.isFixed) {
            const lock = document.createElement('div');
            lock.className = 'lock-badge';
            lock.innerHTML = `
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            `;
            tileBtn.appendChild(lock);
          }

          // 回転用ラッパー
          const rotator = document.createElement('div');
          rotator.className = 'tile-rotator';
          rotator.style.transform = `rotate(${tile.rotation * 90}deg)`;
          rotator.innerHTML = this.createTileSvg(tile.type);

          tileBtn.appendChild(rotator);

          // タップイベント
          tileBtn.addEventListener('click', () => this.handleTileClick(r, c));

          this.gridContainer.appendChild(tileBtn);
          this.tileElements.set(key, tileBtn);
        }
      }

      this.updateAllTileVisuals();
      this.updateStatsUI();
    }

    private handleTileClick(r: number, c: number) {
      if (this.logic.isSolved) return;
      const tile = this.logic.grid[r][c];
      if (tile.isFixed) return;

      const prevPoweredCount = this.logic.poweredTiles.size;
      const rotated = this.logic.rotateTile(r, c);
      if (!rotated) return;

      const key = `${r},${c}`;
      const currentTurns = (this.tileTurns.get(key) || 0) + 1;
      this.tileTurns.set(key, currentTurns);

      const tileEl = this.tileElements.get(key);
      if (tileEl) {
        const rotator = tileEl.querySelector('.tile-rotator') as HTMLElement;
        if (rotator) {
          rotator.style.transform = `rotate(${currentTurns * 90}deg)`;
        }
      }

      this.updateAllTileVisuals();
      this.updateStatsUI();

      if (this.logic.isSolved) {
        this.sound.playSuccess();
        setTimeout(() => {
          this.modalMovesEl.textContent = String(this.logic.moveCount);
          this.clearOverlayEl.classList.remove('is-hidden');
        }, 350);
      } else {
        if (this.logic.poweredTiles.size > prevPoweredCount) {
          this.sound.playConnect();
        } else {
          this.sound.playClick();
        }
      }
    }

    private updateAllTileVisuals() {
      for (let r = 0; r < this.logic.rows; r++) {
        for (let c = 0; c < this.logic.cols; c++) {
          const key = `${r},${c}`;
          const tileEl = this.tileElements.get(key);
          if (!tileEl) continue;

          const isPowered = this.logic.isPowered(r, c);
          tileEl.classList.toggle('is-powered', isPowered);
        }
      }
    }

    private updateStatsUI() {
      this.moveCountEl.textContent = String(this.logic.moveCount);

      if (this.logic.isSolved) {
        this.statusBadgeEl.classList.remove('is-disconnected');
        this.statusBadgeEl.classList.add('is-connected');
        this.statusTextEl.textContent = '回路通電中！';
      } else {
        this.statusBadgeEl.classList.remove('is-connected');
        this.statusBadgeEl.classList.add('is-disconnected');
        this.statusTextEl.textContent = '回路遮断中';
      }
    }

    private createTileSvg(type: PipeType): string {
      switch (type) {
        case 'straight':
          return `
            <svg class="tile-svg" viewBox="0 0 100 100">
              <line class="pipe-path" x1="50" y1="8" x2="50" y2="92" />
            </svg>
          `;
        case 'lShape':
          return `
            <svg class="tile-svg" viewBox="0 0 100 100">
              <path class="pipe-path" d="M 50 8 Q 50 50 92 50" />
            </svg>
          `;
        case 'battery':
          return `
            <svg class="tile-svg" viewBox="0 0 100 100">
              <!-- 右と下への端子スタブ -->
              <line class="terminal-stub" x1="50" y1="50" x2="92" y2="50" stroke="currentColor" stroke-width="12" stroke-linecap="round" />
              <line class="terminal-stub" x1="50" y1="50" x2="50" y2="92" stroke="currentColor" stroke-width="12" stroke-linecap="round" />
              <!-- バッテリー稲妻アイコン -->
              <path class="battery-icon" d="M 55 18 L 32 50 L 48 50 L 42 78 L 68 44 L 52 44 Z" />
            </svg>
          `;
        case 'engine':
          return `
            <svg class="tile-svg" viewBox="0 0 100 100">
              <!-- 上と左への端子スタブ -->
              <line class="terminal-stub" x1="50" y1="50" x2="50" y2="8" stroke="currentColor" stroke-width="12" stroke-linecap="round" />
              <line class="terminal-stub" x1="50" y1="50" x2="8" y2="50" stroke="currentColor" stroke-width="12" stroke-linecap="round" />
              <!-- 歯車エンジンアイコン -->
              <path class="engine-icon" d="M 50 35 A 15 15 0 1 0 50 65 A 15 15 0 1 0 50 35 Z M 54 20 L 46 20 L 45 28 L 41 30 L 35 24 L 29 30 L 35 36 L 33 40 L 25 41 L 25 49 L 33 50 L 35 54 L 29 60 L 35 66 L 41 60 L 45 62 L 46 70 L 54 70 L 55 62 L 59 60 L 65 66 L 71 60 L 65 54 L 67 50 L 75 49 L 75 41 L 67 40 L 65 36 L 71 30 L 65 24 L 59 30 L 55 28 Z" fill-rule="evenodd" />
            </svg>
          `;
      }
    }
  }

  // 初期化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new BypassPuzzleGameUI());
  } else {
    new BypassPuzzleGameUI();
  }
</script>
