---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout
  title="Home"
  description="My personal portfolio and tool repository."
>
  <section
    style="position:relative; min-height:80vh; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#0a0a0a;"
  >
    <!-- Background pattern -->
    <div
      style="position:absolute; inset:0; opacity:0.04;"
      aria-hidden="true"
    >
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
            <path d="M 60 0 L 0 0 0 60" fill="none" stroke="white" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>

    <!-- Content -->
    <div style="position:relative; z-index:1; text-align:center; padding:2rem 1.5rem; max-width:900px;">
      <h1 style="font-size:clamp(2.5rem, 8vw, 6rem); font-weight:900; letter-spacing:-0.02em; line-height:1.05; margin-bottom:1rem; color:#fff;">
        MY<br /><span style="color:#f97316;">PORTFOLIO</span>
      </h1>
      <p style="font-size:clamp(0.95rem, 2.5vw, 1.25rem); font-weight:700; color:#e5e7eb; line-height:1.6; max-width:600px; margin:0 auto 2.5rem;">
        Cloudflare Pagesベースの<br />
        小型ツール開発・公開用環境
      </p>

      <div style="display:flex; flex-wrap:wrap; gap:1rem; justify-content:center;">
        <div
          style="background:rgba(255,255,255,0.05); border:1px solid #2a2a2a; border-radius:8px; padding:2rem; width:100%; max-width:400px;"
        >
          <h2 style="color:#fff; font-size:1.25rem; font-weight:700; margin-bottom:1rem;">Tools</h2>
          <p style="color:#9ca3af; font-size:0.9rem;">
            ここに作成したツールが並びます。
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
