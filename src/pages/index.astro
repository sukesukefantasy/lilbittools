---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout
  title="Home"
  description="My personal portfolio and tool repository."
>
  <section
    style="position:relative; min-height:80vh; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#0a0a0a;"
  >
    <!-- Background pattern -->
    <div
      style="position:absolute; inset:0; opacity:0.04;"
      aria-hidden="true"
    >
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
            <path d="M 60 0 L 0 0 0 60" fill="none" stroke="white" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>

    <!-- Content -->
    <div style="position:relative; z-index:1; text-align:center; padding:2rem 1.5rem; max-width:900px;">
      <h1 style="font-size:clamp(2.5rem, 8vw, 6rem); font-weight:900; letter-spacing:-0.02em; line-height:1.05; margin-bottom:1rem; color:#fff;">
        NSK Tools<br /><span style="color:#D2BEA4;">Repository</span>
      </h1>
      <p style="font-size:clamp(0.95rem, 2.5vw, 1.25rem); font-weight:700; color:#e5e7eb; line-height:1.6; max-width:600px; margin:0 auto 2.5rem;">
        小型ツールリポジトリ
      </p>

      <div style="display:flex; flex-wrap:wrap; gap:1.5rem; justify-content:center;">
        <a
          href="/hiragana-gacha"
          class="card"
          style="text-align:left; width:100%; max-width:320px; transition:border-color 0.2s ease, transform 0.2s ease; text-decoration:none;"
        >
          <h2 style="color:#fff; font-size:1.15rem; font-weight:700; margin-bottom:0.5rem;">
            ひらがなガチャ
          </h2>
          <p style="color:#9ca3af; font-size:0.85rem; line-height:1.6; margin-bottom:1.25rem;">
            ボタンを押すたびに2〜4文字のひらがながランダムに生成される、シンプルなガチャツール。
          </p>
          <span class="btn-primary" style="padding:0.5rem 1.25rem; font-size:0.85rem;">遊んでみる</span>
        </a>

        <a
          href="/hiragana-combo"
          class="card"
          style="text-align:left; width:100%; max-width:320px; transition:border-color 0.2s ease, transform 0.2s ease; text-decoration:none;"
        >
          <h2 style="color:#fff; font-size:1.15rem; font-weight:700; margin-bottom:0.5rem;">
            文字コンボ
          </h2>
          <p style="color:#9ca3af; font-size:0.85rem; line-height:1.6; margin-bottom:1.25rem;">
            長さと数を自由に選べるひらがなの箱を並べて、思いがけない言葉が生まれるか試すツール。
          </p>
          <span class="btn-primary" style="padding:0.5rem 1.25rem; font-size:0.85rem;">遊んでみる</span>
        </a>

        <a
          href="/SvgDrawer"
          class="card"
          style="text-align:left; width:100%; max-width:320px; transition:border-color 0.2s ease, transform 0.2s ease; text-decoration:none;"
        >
          <h2 style="color:#fff; font-size:1.15rem; font-weight:700; margin-bottom:0.5rem;">
            SVGパス変換
          </h2>
          <p style="color:#9ca3af; font-size:0.85rem; line-height:1.6; margin-bottom:1.25rem;">
            キャンバスに描いた線を、リアルタイムでSVGパスコードへ変換する描画ツール。
          </p>
          <span class="btn-primary" style="padding:0.5rem 1.25rem; font-size:0.85rem;">使ってみる</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
